  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0423 \u043A\u0430\u0436\u0434\u043E\u0439 \u0437\u0430\u0434\u0432\u0438\u0436\u043A\u0438
    \u0435\u0441\u0442\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0430\u044F
    \u0441\u0442\u043E\u0440\u043E\u043D\u0430 \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
    \u0437\u0430\u0433\u043B\u0443\u0448\u043A\u0438. \u0417\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0439\u0442\u0435
    \u0438\u0445.\n\n\u0421\u0442\u043E\u0440\u043E\u043D\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F
    \u043F\u043E \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0443: \u0435\u0441\u043B\u0438
    \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u044C \u0432\u044B\u0445\u043E\u0434\u0438\u0442
    \u0438\u0437 \u0420\u0412\u0421, \u0437\u0430\u0433\u043B\u0443\u0448\u043A\u0430
    \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0420\u0412\u0421. A
    \u0435\u0441\u043B\u0438 \u0436\u0435 \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u044C
    \u0432\u0445\u043E\u0434\u0438\u0442, \u0442\u043E \u0437\u0430\u0433\u043B\u0443\u0448\u043A\u0430
    \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u0434\u0432\u0438\u0436\u043A\u0438.\n"
