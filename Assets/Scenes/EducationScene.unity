    \u0432 \u0440\u0435\u0436\u0438\u043C \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F!\n\n\u0412\u0430\u043C
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u0437\u0430\u0433\u043B\u0443\u0448\u043A\u0438 \u043D\u0430 \u0432\u0441\u0435
    \u0437\u0430\u0434\u0432\u0438\u0436\u043A\u0438, \u043E\u043D\u0438 \u0443\u043A\u0430\u0437\u0430\u043D\u044B
    \u043A\u0440\u0430\u0441\u043D\u044B\u043C\u0438 \u043C\u0435\u0442\u043A\u0430\u043C\u0438.
    \u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435 \u0432\u0441\u0435 \u0437\u043E\u043D\u044B
    \u0434\u043B\u044F \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0433\u043E \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F."
